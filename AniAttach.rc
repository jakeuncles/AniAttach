#include "version.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ANIATTACH_MAJOR, ANIATTACH_MINOR, ANIATTACH_REV, ANIATTACH_BUILD
 PRODUCTVERSION ANIATTACH_MAJOR, ANIATTACH_MINOR, ANIATTACH_REV, ANIATTACH_BUILD
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Daz Studio plug-in: pick up and put down props over the timeline"
            VALUE "InternalName", "AniAttach"
            VALUE "ProductName", "AniAttach for Daz Studio 6"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
